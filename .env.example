# Copy to .env.local. Leave the Redis values empty in dev to use the in-memory store.

# Upstash Redis (the Vercel Marketplace integration sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public address of the site, used for the link-preview image. Production: https://mannivaat.in
NEXT_PUBLIC_SITE_URL=

# Show languages that are still drafts (Bodo, Kashmiri, Santali, Manipuri) in the language picker.
# NEXT_PUBLIC_SHOW_DRAFT_LANGS=1

# Local testing of a production build without Redis. NEVER set this on a real deploy.
# ALLOW_MEMORY_STORE=1
