# Copy to .env.local. Leave the Redis values empty in dev to use the in-memory store.

# Upstash Redis (the Vercel Marketplace integration sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public address of the site, used for the link-preview image. Example: https://mannivaat.in
NEXT_PUBLIC_SITE_URL=

# Local testing of a production build without Redis. NEVER set this on a real deploy.
# ALLOW_MEMORY_STORE=1
